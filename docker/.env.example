# ArmadaBench Docker Environment Configuration
# Copy this file to .env and fill in your API keys

# LLM API Keys (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Run Configuration
RUN_ID=test-run-001
RUN_CONFIG=/app/configs/sample_run.json

# Logging
LOG_LEVEL=INFO

# Vassal Configuration
SKIP_XVFB=false
ENABLE_VNC=false  # Set to true for debugging

# ISB API Configuration (optional - defaults to production)
# ISB_API_URL=https://api.swarmada.wiki/api/mcp
